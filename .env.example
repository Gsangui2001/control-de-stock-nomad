# Nomad Stock — variables de entorno
#
# La app FUNCIONA SIN estas variables: si no están definidas, arranca en
# "Modo demo" con datos de ejemplo guardados en el localStorage del navegador.
#
# Para conectar Supabase (datos reales, multi-dispositivo), copiá este archivo
# a `.env.local` y completá con los valores de tu proyecto Supabase
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Para "Escanear ticket" en Compras (lee la foto de la factura con IA y
# precarga los ítems). Sin esta variable, el botón muestra un error pero el
# resto de la app sigue funcionando normal.
ANTHROPIC_API_KEY=
